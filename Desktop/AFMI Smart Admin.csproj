<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>AFMI_Gestion_projet</RootNamespace>
    <AssemblyName>AFMI Smart Admin</AssemblyName>
    <!-- Version de l application ; build_installer.bat la fixe aussi (-p:Version). Sert à la mise à jour automatique. -->
    <Version>2.3.3</Version>
    <!-- Icône de l'application = logo de l'association (branding/logo.png → app.ico par installer/make_icon.py) -->
    <ApplicationIcon Condition="Exists('..\branding\app.ico')">..\branding\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\AFMI.Core.csproj" />
  </ItemGroup>

</Project>
