<UserControl behaviors:FileDrop.Command="{Binding DropPhotosCommand}" x:Class="AFMI_Gestion_projet.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:behaviors="clr-namespace:AFMI_Gestion_projet.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AFMI_Gestion_projet.Models;assembly=AFMI.Core"
             xmlns:converters="clr-namespace:AFMI_Gestion_projet.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1150">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: En-tête & Sélecteur de Contexte Projet -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖 Agent IA Interne — Rédaction &amp; Synthèse" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="100% GRATUIT &amp; HORS-LIGNE" FontSize="10.5" FontWeight="Bold" Foreground="#166534"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Génération automatique de comptes rendus de réunion, rédaction de rapports officiels, correction et reformulation contextuelle." 
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Project Selector for Context Injection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Projet en Contexte :" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableProjects}" 
                              SelectedItem="{Binding SelectedProject}" 
                              DisplayMemberPath="Name" 
                              Width="260" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="15,10,15,15" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: COMPTES RENDUS DE RÉUNION -->
            <TabItem Header="📝  Comptes Rendus de Réunion" Padding="14,8" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne Gauche : Saisie des Paramètres et Notes -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Paramètres du Compte Rendu" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                                <!-- Type de séance -->
                                <TextBlock Text="Type de Réunion" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding MeetingTypes}" SelectedItem="{Binding SelectedMeetingType}" Height="30" Margin="0,0,0,10"/>

                                <!-- Titre -->
                                <TextBlock Text="Intitulé de la Réunion" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingTitle, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" Margin="0,0,0,10"/>

                                <!-- Date et Lieu -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Date" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <DatePicker SelectedDate="{Binding MeetingDate}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Lieu / Format" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding MeetingLocation, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Animateur & Secrétaire -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Animateur / Président" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding MeetingOrganizer, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rédacteur / Secrétaire" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding MeetingSecretary, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Participants -->
                                <TextBlock Text="Participants présents (noms ou entités)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingAttendees, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" Margin="0,0,0,10"/>

                                <!-- Ordre du jour -->
                                <TextBlock Text="Ordre du Jour (un point par ligne)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingAgenda, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Padding="6,4" Margin="0,0,0,10"/>

                                <!-- Notes brutes des échanges -->
                                <TextBlock Text="Notes brutes, discussions &amp; décisions prises" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingRawNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Padding="6,4" Margin="0,0,0,10"/>

                                <!-- Questions de cadrage (CR) -->
                                <TextBlock Text="Questions Guides pour l'IA (Optionnel)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,5"/>
                                
                                <TextBlock Text="Quelles sont les décisions majeures prises ?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingQDecisions, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="Y a-t-il des points bloquants soulevés ?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingQBlockers, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="Quelles sont les prochaines étapes clés ?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding MeetingQNextSteps, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,15"/>

                                <!-- Photos / Médias -->
                                <TextBlock Text="Photos &amp; Médias (Optionnel)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,5"/>
                                <Button Content="+ Importer des photos" Command="{Binding ImportPhotosCommand}" Background="#EEEEEE" Padding="8" BorderThickness="0" Margin="0,0,0,10"/>
                                
                                <ItemsControl ItemsSource="{Binding ImportedPhotos}" Margin="0,0,0,15">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,5" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding}" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Button Grid.Column="1" Content="X" Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0" Padding="5,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Bouton Générer -->
                                <Button Content="⚡ Générer le Compte Rendu (IA Gratuite)" 
                                        Command="{Binding GenerateMinutesCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Height="38" FontSize="13"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Colonne Droite : Aperçu et Actions du CR -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barre d'actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Document Rédigé &amp; Structuré" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="📋 Copier le texte" Command="{Binding CopyMinutesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                                    <Button Content="📄 Exporter en Word (.docx)" Command="{Binding ExportMinutesWordCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6"/>
                                </StackPanel>
                            </Grid>

                            <!-- Zone de texte du compte rendu -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding GeneratedMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas, Segoe UI" 
                                             FontSize="12" 
                                             Padding="15" 
                                             Background="Transparent" 
                                             BorderThickness="0"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: RAPPORTS STRATÉGIQUES & AVANCEMENT -->
            <TabItem Header="📊  Rapports &amp; Synthèses" Padding="14,8" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Colonne Gauche : Paramètres du Rapport -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Configuration du Rapport" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="Type de Rapport Officiel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" Height="30" Margin="0,0,0,14"/>

                            <TextBlock Text="Projet Rattaché" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" Height="30" Margin="0,0,0,14"/>

                            <!-- Métadonnées affichées du projet sélectionné -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProject.Name, FallbackValue='Aucun projet sélectionné'}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextDarkBrush}"/>
                                    <TextBlock Text="{Binding SelectedProject.Code, StringFormat={}Code : {0}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedProject.Manager, StringFormat={}Responsable : {0}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedProject.BudgetGlobal, StringFormat={}Budget : {0:N0} MAD}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Directives &amp; Observations Complémentaires" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ReportAdditionalNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Padding="8" Margin="0,0,0,10"/>

                            <!-- Questions de cadrage (Rapport) -->
                            <TextBlock Text="Questions Guides pour l'IA (Optionnel)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,5"/>

                            <TextBlock Text="Réalisations principales de cette période ?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ReportQAchievements, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

                            <TextBlock Text="Quelles difficultés ont été rencontrées ?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ReportQDifficulties, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,8"/>

                            <TextBlock Text="Objectifs pour la prochaine période ?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ReportQNextObjectives, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,15"/>
                            <Button Content="⚡ Rédiger le Rapport Officiel (IA)" 
                                    Command="{Binding GenerateReportCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="38" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Colonne Droite : Rapport Rédigé -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rapport Consolidé par l'Agent IA" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="📋 Copier le rapport" Command="{Binding CopyReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                                    <Button Content="📄 Exporter en Word (.docx)" Command="{Binding ExportReportWordCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding GeneratedReportText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontFamily="Consolas, Segoe UI" 
                                             FontSize="12" 
                                             Padding="15" 
                                             Background="Transparent" 
                                             BorderThickness="0"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: CORRECTION & REFORMULATION DE TEXTES -->
            <TabItem Header="✨  Correction &amp; Reformulation" Padding="14,8" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barre des Options de Rédaction -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ton &amp; Registre Rédactionnel" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableTones}" SelectedItem="{Binding SelectedTone}" Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Objectif de Transformation" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableGoals}" SelectedItem="{Binding SelectedGoal}" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Éditeur Double Écran (Source vs Résultat) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panneau Texte Source -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Texte Source (Notes, brouillon ou texte brut)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>

                                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontSize="12.5" 
                                             Padding="10" 
                                             Background="Transparent" 
                                             BorderThickness="0"/>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔍 Corriger Orthographe &amp; Ponctuation" 
                                            Command="{Binding CorrectTextCommand}" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Margin="0,0,8,0" Padding="12,6"/>
                                    <Button Content="✨ Reformuler &amp; Améliorer (IA)" 
                                            Command="{Binding ReformulateTextCommand}" 
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Padding="14,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Panneau Texte Amélioré -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Texte Enrichi &amp; Reformulé" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="📋 Copier" Command="{Binding CopyResultCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                        <Button Content="⬅ Remplacer Source" Command="{Binding ReplaceSourceWithResultCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4" FontSize="11"/>
                                        <Button Content="💾 Appliquer au Projet" Command="{Binding ApplyToProjectDescriptionCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                    <TextBox Text="{Binding ResultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             FontSize="12.5" 
                                             Padding="12" 
                                             Background="Transparent" 
                                             BorderThickness="0"/>
                                </Border>

                                <TextBlock Grid.Row="2" Text="{Binding CorrectionsSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Panneau Inférieur : Détails des Corrections apportées -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Détail des Améliorations &amp; Corrections Détectées :" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding CorrectionsList}" MaxHeight="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="• «" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Original}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="» → «" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Replacement}" Foreground="#166534" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="» (" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <TextBlock Text=")" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: PARAMÈTRES MOTEUR IA -->
            <TabItem Header="⚙️  Paramètres Moteur IA" Padding="14,8" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Carte Moteur Interne 100% Gratuit -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Moteur Linguistique Interne (Par Défaut)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Ce moteur est 100% intégré à l'application et ne nécessite aucun abonnement, aucune connexion Internet ni aucune clé d'API. Il traite instantanément vos données en local sur votre poste en toute confidentialité." 
                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="✅ Caractéristiques du Moteur Interne :" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Gratuité totale &amp; illimitée (aucun coût par token ou requête)" FontSize="11.5" Margin="0,2"/>
                                    <TextBlock Text="• Fonctionnement 100% hors-ligne (sécurité &amp; confidentialité totale)" FontSize="11.5" Margin="0,2"/>
                                    <TextBlock Text="• Gabarits professionnels de comptes rendus et rapports AFMI" FontSize="11.5" Margin="0,2"/>
                                    <TextBlock Text="• Dictionnaire de correction orthographique et typographique française" FontSize="11.5" Margin="0,2"/>
                                    <TextBlock Text="• Injection automatique des données de gestion de projet (EVM, jalons, budget)" FontSize="11.5" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Carte Accélération Locale Optionnelle (Ollama) -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Connecteur Local Libre (Ollama / LM Studio)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Optionnel : Si vous avez installé un serveur LLM open-source local comme Ollama (gratuit), l'Agent IA peut lui déléguer l'enrichissement des textes sans jamais faire appel à un service externe payant." 
                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                            <CheckBox Content="Activer le connecteur local Ollama" IsChecked="{Binding UseOllama}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <TextBlock Text="URL du serveur local (défaut : http://localhost:11434)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" Margin="0,0,0,12"/>

                            <TextBlock Text="Nom du modèle local (ex: mistral, llama3, qwen2.5)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" Margin="0,0,0,15"/>

                            <Button Content="Tester la connexion au serveur local" 
                                    Command="{Binding TestOllamaCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="32" Margin="0,0,0,15"/>

                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock Text="{Binding OllamaStatusMessage}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextDarkBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Carte Cloud API (OpenAI/Gemini) -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Connecteur Cloud API (OpenAI / Gemini)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Optionnel : Connectez l'application à un fournisseur d'IA Cloud (ex: OpenAI GPT-4) pour bénéficier d'une compréhension linguistique avancée (nécessite une clé API)." 
                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                            <CheckBox Content="Activer l'API Cloud" IsChecked="{Binding UseCloudApi}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <TextBlock Text="Fournisseur Cloud" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding CloudProvider}" Height="28" Margin="0,0,0,12"/>

                            <TextBlock Text="Clé API (Secrète)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding CloudApiKey, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" Margin="0,0,0,15"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="30,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding BusyStatus}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
