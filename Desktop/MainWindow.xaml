<Window x:Class="AFMI_Gestion_projet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AFMI_Gestion_projet"
        xmlns:viewmodels="clr-namespace:AFMI_Gestion_projet.ViewModels"
        xmlns:views="clr-namespace:AFMI_Gestion_projet.Views"
        xmlns:treasury="clr-namespace:AFMI_Gestion_projet.ViewModels.Treasury"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgLightBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- MVVM View-ViewModel mappings -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PortfolioViewModel}">
            <views:PortfolioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProjectDetailViewModel}">
            <views:ProjectDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TemplateViewModel}">
            <views:TemplateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AiAssistantViewModel}">
            <views:AiAssistantView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FundersViewModel}">
            <views:FundersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type treasury:TreasuryViewModel}">
            <views:TreasuryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SmartOfficeViewModel}">
            <views:SmartOfficeView />
        </DataTemplate>

        <!-- Custom Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#334155"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#475569"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,25,20,30">
                    <TextBlock Text="AFMI SMART ADMIN" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="None" TextWrapping="Wrap"/>
                    <TextBlock Text="Projets · Agents IA · Finances" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1">
                    <Button Content="🏠   Tableau de bord" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="dashboard" 
                            Style="{StaticResource SidebarButtonStyle}"/>
                    
                    <Button Content="📊   Portefeuille" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="portfolio" 
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="📂   Modèles de Projets" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="templates" 
                            Style="{StaticResource SidebarButtonStyle}"/>
                            
                    <Button Content="🏦   Trésorerie"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="treasury"
                            ToolTip="Comptes bancaires et caisse, opérations, virements, rapprochement, prévisions"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="🏢   Bailleurs de Fonds" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="funders" 
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="🤖   Agent IA Interne" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="ai_assistant"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="🌲   Smart Office"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="smart_office"
                            ToolTip="Agents IA, OCR financier, radar d'appels à projets, mémoire institutionnelle"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Separator Background="#334155" Margin="10,15,10,15"/>

                    <Button Content="⚙️   Paramètres"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="settings"
                            ToolTip="Configuration générale : association, comptabilité, banques, IA (Gemini, Claude, ChatGPT, Ollama), messagerie, utilisateurs, sauvegardes"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="📤   Exporter la base" 
                            Command="{Binding ExportDbCommand}" 
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="📥   Importer une base" 
                            Command="{Binding ImportDbCommand}" 
                            Visibility="{Binding IsNotDemoMode, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="🎓   Démonstration"
                            Command="{Binding OpenDemoCommand}"
                            ToolTip="Ouvre une association fictive (3 projets, 3 comptes, 12 relevés) dans une seconde fenêtre, sans toucher à vos données"
                            Visibility="{Binding IsNotDemoMode, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SidebarButtonStyle}"/>
                    <TextBlock Text="DÉMONSTRATION — données fictives" Foreground="#FBBF24" FontWeight="Bold" Margin="15,10" TextWrapping="Wrap"
                               Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Footer / Notifications Status -->
                <Border Grid.Row="2" Background="#0F172A" Padding="15,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Statut Global" FontSize="11.5" Foreground="#64748B"/>
                            <TextBlock Text="Base de données locale" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Notification Badge (Late tasks) -->
                        <Border Grid.Column="1" CornerRadius="10" Background="{StaticResource DangerBrush}" Padding="8,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <TextBlock Text="{Binding ActiveViewName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Session :" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" Administrateur" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>

        <!-- SMTP CONFIGURATION DIALOG OVERLAY -->
        <Grid Grid.ColumnSpan="2" Background="#7F000000" 
              Visibility="{Binding IsSmtpConfigVisible, Converter={StaticResource BoolToVis}}"
              IsVisibleChanged="OnSmtpOverlayVisibleChanged">
            <Border Style="{StaticResource CardStyle}" Width="450" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Configuration SMTP &amp; Diffusion" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                    <!-- Form -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <!-- SMTP Server -->
                        <TextBlock Text="Serveur SMTP *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding SmtpConfig.Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- SMTP Port -->
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Port SMTP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding SmtpConfig.Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                            </StackPanel>

                            <!-- Schedule Type -->
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Diffusion Automatique" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox SelectedItem="{Binding SmtpConfig.ScheduleType}" Margin="0,5,0,10">
                                    <System:String>Aucun</System:String>
                                    <System:String>Hebdomadaire</System:String>
                                    <System:String>Mensuel</System:String>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Username -->
                        <TextBlock Text="Nom d'utilisateur / Adresse e-mail *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding SmtpConfig.Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                        <!-- Password -->
                        <TextBlock Text="Mot de passe" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <PasswordBox x:Name="SmtpPasswordBox" Margin="0,5,0,10" Height="34"/>

                        <!-- Recipient Email -->
                        <TextBlock Text="Adresse de réception des rapports *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding SmtpConfig.RecipientEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Annuler" Click="OnCancelSmtpClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Enregistrer" Click="OnSaveSmtpClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
