<UserControl x:Class="AFMI_Gestion_projet.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:behaviors="clr-namespace:AFMI_Gestion_projet.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:AFMI_Gestion_projet.Models;assembly=AFMI.Core"
             xmlns:converters="clr-namespace:AFMI_Gestion_projet.Converters"
             xmlns:views="clr-namespace:AFMI_Gestion_projet.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <converters:SCurveToPointsConverter x:Key="PvPointsConv" LineType="PV" CanvasWidth="550" CanvasHeight="180"/>
        <converters:SCurveToPointsConverter x:Key="EvPointsConv" LineType="EV" CanvasWidth="550" CanvasHeight="180"/>
        <converters:SCurveToPointsConverter x:Key="AcPointsConv" LineType="AC" CanvasWidth="550" CanvasHeight="180"/>

        <!-- Hierarchical Data Template for WBS TreeView -->
        <HierarchicalDataTemplate DataType="{x:Type models:ProjectTask}" ItemsSource="{Binding SubTasks}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Task Name -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D1D1D1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Terminé">
                                        <Setter Property="Fill" Value="#107C41"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="En cours">
                                        <Setter Property="Fill" Value="#0078D4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Bloqué">
                                        <Setter Property="Fill" Value="#A80000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                </StackPanel>

                <!-- Assignee -->
                <TextBlock Grid.Column="1" Text="{Binding Assignee}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>

                <!-- Progress Bar -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="5,0,15,0">
                    <ProgressBar Value="{Binding ProgressPercentage}" Height="12" Maximum="100" BorderThickness="0" Background="#E5E7EB" Foreground="#107C41"/>
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="9.5" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Budget -->
                <TextBlock Grid.Column="3" Text="{Binding Budget, StringFormat={}{0:N0} MAD}" VerticalAlignment="Center"/>

                <!-- Cost -->
                <TextBlock Grid.Column="4" Text="{Binding Cost, StringFormat={}{0:N0} MAD}" VerticalAlignment="Center"/>

                <!-- Status Label -->
                <Border Grid.Column="5" CornerRadius="8" Padding="6,2" HorizontalAlignment="Left" Background="#F3F4F6">
                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold"/>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📝 CR" Command="{Binding DataContext.OpenActivityReportWizardCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" ToolTip="Nouveau Compte Rendu d'Activité" FontSize="10" Padding="6,2" Height="24" Margin="0,0,5,0" Background="#28A745" Foreground="White" BorderThickness="0"/>
                    <Button Content="+" Command="{Binding DataContext.OpenAddTaskCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" ToolTip="Ajouter sous-tâche" Width="24" Height="24" Padding="0" Margin="0,0,5,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Éditer" Command="{Binding DataContext.OpenEditTaskCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" FontSize="10" Padding="6,2" Height="24" Margin="0,0,5,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Suppr" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" FontSize="10" Padding="6,2" Height="24" Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (Header) -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Back Button -->
                <Button Content="← Retour" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,15,0" VerticalAlignment="Center"/>

                <!-- Project Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Project.Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                        <Border CornerRadius="4" Background="{StaticResource PrimaryBrush}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Project.Code}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Project.Manager, StringFormat={}Responsable : {0}}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Project Dates & Status & AI Shortcut -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="📁 Dossiers Locaux" 
                            Command="{Binding OpenProjectFolderCommand}" 
                            ToolTip="Ouvrir le dossier local du projet" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="10,4" FontSize="11.5" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="➕ Créer Dossiers" 
                            Command="{Binding CreateProjectFoldersCommand}" 
                            ToolTip="Créer l'arborescence des dossiers trimestriels (CR, Rapports)" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Padding="10,4" FontSize="11.5" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="🤖 Rédacteur IA" 
                            Command="{Binding OpenAiAssistantForProjectCommand}" 
                            ToolTip="Ouvrir l'Agent IA pour générer comptes rendus et rapports pour ce projet" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="10,4" FontSize="11.5" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="12" Padding="10,4" Background="#D2E3FC" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Project.Status}" FontSize="12" FontWeight="Bold" Foreground="#1A73E8"/>
                    </Border>
                    <TextBlock Text="{Binding Project.TargetEndDate, StringFormat={}Échéance : {0:dd/MM/yyyy}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTROL -->
        <TabControl Grid.Row="1" Margin="10" SelectionChanged="OnProjectTabChanged">
            <!-- TAB 1: SYNTHESE & EVM -->
            <TabItem Header="Synthèse &amp; EVM">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Executive summary assistant -->
                        <Border Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="RÉDACTION ASSISTÉE : SYNTHÈSE DE PERFORMANCE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Synthesis.ExecutiveSummary}" TextWrapping="Wrap" FontSize="13" LineHeight="18" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- EVM Metrics & Graph -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <!-- EVM Grid -->
                            <TextBlock Text="Indicateurs de la Valeur Acquise (EVM)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="3" Rows="3" Margin="0,0,0,20">
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Budget Initial (BAC)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.BAC, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Valeur Planifiée (PV)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.PV, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Valeur Acquise (EV)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.EV, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Coût Réel Engagé (AC)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.AC, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Indice Coût (CPI)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.CPI, StringFormat={}{0:F2}}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Metrics.CPI, Converter={StaticResource BoolToVis}}" Value="True"> <!-- Just placeholder for coloring trigger -->
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Indice Délai (SPI)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.SPI, StringFormat={}{0:F2}}" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Coût Estimé Final (EAC)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.EAC, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Reste à Dépenser (ETC)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.ETC, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Écart Consolidé (VAC)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Metrics.VAC, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Vector S-Curve Draw -->
                            <TextBlock Text="Courbe de Suivi en S (PV vs EV vs AC)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource CardStyle}" Padding="10">
                                <Grid Height="200">
                                    <Canvas Background="White" ClipToBounds="True">
                                        <!-- Y Axis Helper lines -->
                                        <Line X1="0" Y1="10" X2="550" Y2="10" Stroke="#E5E7EB" StrokeThickness="1"/>
                                        <Line X1="0" Y1="100" X2="550" Y2="100" Stroke="#E5E7EB" StrokeThickness="1"/>
                                        <Line X1="0" Y1="180" X2="550" Y2="180" Stroke="#E5E7EB" StrokeThickness="1"/>

                                        <!-- PV Line (Blue) -->
                                        <Polyline Points="{Binding SCurveData, Converter={StaticResource PvPointsConv}}" Stroke="{StaticResource InfoBrush}" StrokeThickness="2.5"/>
                                        <!-- EV Line (Green) -->
                                        <Polyline Points="{Binding SCurveData, Converter={StaticResource EvPointsConv}}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.5"/>
                                        <!-- AC Line (Red) -->
                                        <Polyline Points="{Binding SCurveData, Converter={StaticResource AcPointsConv}}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2.5"/>
                                    </Canvas>
                                    
                                    <!-- Legend Overlay -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                            <Rectangle Width="12" Height="4" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Prévu (PV)" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                            <Rectangle Width="12" Height="4" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Acquis (EV)" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="12" Height="4" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Réel (AC)" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Risks & Actions lists -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                            <!-- Risks -->
                            <TextBlock Text="Risques Relevés" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,15">
                                <ItemsControl ItemsSource="{Binding Synthesis.Risks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}• {0}}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Actions -->
                            <TextBlock Text="Actions Conseillées" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource CardStyle}" Padding="10">
                                <ItemsControl ItemsSource="{Binding Synthesis.Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}• {0}}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: STRUCTURE ARBORESCENTE (WBS) -->
            <TabItem Header="Hiérarchie (WBS)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Structure de Décomposition du Travail (WBS)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                        <Button Content="+ Tâche Racine" Command="{Binding OpenAddTaskCommand}" HorizontalAlignment="Right" Padding="12,6"/>
                    </Grid>

                    <!-- TreeView Grid Headers -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="5,5,0,0" Padding="25,10,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Nom de la tâche" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="0"/>
                                    <TextBlock Text="Responsable" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="1"/>
                                    <TextBlock Text="Progression" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="2" Margin="5,0,0,0"/>
                                    <TextBlock Text="Budget" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="3"/>
                                    <TextBlock Text="Coût Réel" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="4"/>
                                    <TextBlock Text="Statut" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="5"/>
                                    <TextBlock Text="Actions" FontWeight="Bold" Foreground="White" FontSize="12" Grid.Column="6" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TreeView Grid.Row="1" ItemsSource="{Binding RootTasks}" Margin="0,5,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: DIAGRAMME DE GANTT -->
            <TabItem Header="Diagramme de Gantt">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Planning Réseau &amp; Diagramme de Gantt" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Width="950" Height="500" Background="White">
                            <!-- Timeline grid lines -->
                            <Canvas Grid.Row="0" Width="950" Height="500" IsHitTestVisible="False">
                                <Line X1="50" Y1="0" X2="50" Y2="500" Stroke="#E5E7EB" StrokeThickness="1"/>
                                <Line X1="200" Y1="0" X2="200" Y2="500" Stroke="#E5E7EB" StrokeThickness="1"/>
                                <Line X1="400" Y1="0" X2="400" Y2="500" Stroke="#E5E7EB" StrokeThickness="1"/>
                                <Line X1="600" Y1="0" X2="600" Y2="500" Stroke="#E5E7EB" StrokeThickness="1"/>
                                <Line X1="800" Y1="0" X2="800" Y2="500" Stroke="#E5E7EB" StrokeThickness="1"/>
                            </Canvas>

                            <!-- Dependencies (Dashed lines) -->
                            <ItemsControl ItemsSource="{Binding GanttDependencies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="500" Width="900" IsHitTestVisible="False"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#9CA3AF" StrokeThickness="1.5" StrokeDashArray="3,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Gantt Bars -->
                            <ItemsControl ItemsSource="{Binding GanttTasks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="500" Width="900"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Task.Description}">
                                            <!-- Gantt bar -->
                                            <Border Height="18" Width="{Binding Width}" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsParent}" Value="True">
                                                                <Setter Property="Background" Value="#374151"/>
                                                                <Setter Property="Height" Value="10"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Task.Status}" Value="Terminé">
                                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Task.Status}" Value="Bloqué">
                                                                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <TextBlock Text="{Binding Task.ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="9.5" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Task details right of bar -->
                                            <TextBlock Text="{Binding Task.Name}" FontSize="10.5" Foreground="{StaticResource TextDarkBrush}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: WORKFLOW & ETAPES -->
            <TabItem Header="Cycle de Vie (Workflow)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Cycle de Vie du Projet &amp; Portes d'Étapes" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                        <Button Content="+ Ajouter Étape Personnalisée" Command="{Binding OpenAddStepCommand}" HorizontalAlignment="Right" Padding="12,6"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <ListView ItemsSource="{Binding WorkflowSteps}" BorderThickness="0" Background="Transparent" AlternationCount="2">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Is Completed Checkbox -->
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" 
                                                      Command="{Binding DataContext.ToggleStepCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                      CommandParameter="{Binding}" 
                                                      VerticalAlignment="Center" Margin="0,0,15,0"/>

                                            <TextBlock Grid.Column="1" Text="{Binding StepName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Validé le :" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding CompletedDate, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='En attente'}" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Button Grid.Column="3" Content="Supprimer" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}" FontSize="11.5" Height="28" Padding="10,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: REGISTRE DES COÛTS -->
            <TabItem Header="Budget &amp; Dépenses">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Registre des Transactions Financières" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Exporter Budget CSV" Command="{Binding ExportBudgetCsvCommand}" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="+ Enregistrer Dépense" Command="{Binding OpenAddCostCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding CostEntries}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="150"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Ressource / Fournisseur" Binding="{Binding ResourceName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Coût Estimé" Binding="{Binding EstimatedCost, StringFormat={}{0:N0} MAD}" Width="120"/>
                                <DataGridTextColumn Header="Coût Réel engagé" Binding="{Binding ActualCost, StringFormat={}{0:N0} MAD}" Width="120"/>
                                
                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Supprimer" Command="{Binding DataContext.DeleteCostCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}" FontSize="10.5" Padding="6,2" Height="24"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: RAPPORTS (QuestPDF) -->
            <TabItem Header="Rapports">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Report configuration parameters -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Options de Génération" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Couleur de Thème Graphique (Hex)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding ReportThemeColor}" Margin="0,5,0,20"/>

                                <TextBlock Text="Choix du Type de Rapport :" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" Height="34" Margin="0,0,0,12"/>
                                
                                <Button Content="Générer et ouvrir dans l'éditeur" Command="{Binding ShowPreviewCommand}" Height="36" Margin="0,0,0,6"/>
                                <TextBlock Text="Le rapport s'ouvre dans l'éditeur de type Word : modifiable, aux couleurs de la charte, exportable en Word, PDF et PDF/A (menu « Exporter… » de l'éditeur). Chaque régénération crée une nouvelle version." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                <!-- Export Format and Final Button -->
                                <StackPanel IsEnabled="{Binding IsPreviewVisible}">
                                    <Separator Background="#CBD5E1" Margin="0,5,0,15"/>
                                    <TextBlock Text="Format d'Exportation :" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableExportFormats}" SelectedItem="{Binding SelectedExportFormat}" Height="34" Margin="0,0,0,12"/>
                                    
                                    <Button Content="Exporter le Rapport Final" Command="{Binding ExportReportCommand}" Height="36"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Report Display (Preview / History tabs) -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <!-- Tab 1: Live Preview -->
                            <TabItem Header="Aperçu du Rapport" Padding="12,6">
                                <Grid Margin="0,15,0,0">
                                    <TextBlock Text="Aucun aperçu chargé. Veuillez sélectionner un rapport à gauche et cliquer sur 'Afficher l'Aperçu'." 
                                               Foreground="{StaticResource TextMutedBrush}" 
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="20">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Éditeur de type Word (Smart Office) : le rapport devient un document modifiable et exportable -->
                                    <Grid Visibility="{Binding IsReportEditorVisible, Converter={StaticResource BoolToVis}}">
                                        <wv2:WebView2 x:Name="ReportEditor"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ReportEditorStatus}" Foreground="#92400E" TextWrapping="Wrap" VerticalAlignment="Top" Margin="10,0,10,0"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,24,0,0">
                                        <ScrollViewer.Style>
                                            <Style TargetType="ScrollViewer">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReportEditorVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <StackPanel Margin="10">
                                            <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>
                                            <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="15" Background="#F8FAFC" CornerRadius="4">
                                                <TextBlock Text="{Binding PreviewContent}" FontSize="12.5" FontFamily="Consolas" Foreground="#334155" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- Tab 2: Document History -->
                            <TabItem Header="Historique des Éditions" Padding="12,6">
                                <Grid Margin="0,15,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Historique des Rapports Exportés" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReportHistories}" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type" Binding="{Binding ReportType}" Width="100"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding GeneratedDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                                            <DataGridTextColumn Header="Fichier" Binding="{Binding Title}" Width="1.5*"/>
                                            
                                            <DataGridTemplateColumn Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Ouvrir" Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" FontSize="11" Padding="6,2" Height="24"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Vue 360° du projet (Lot 9) : budget, trésorerie, indicateurs, comptes rendus, documents, alertes -->
            <TabItem Header="Vue 360°" x:Name="OverviewTab">
                <Grid>
                    <wv2:WebView2 x:Name="OverviewBrowser"/>
                    <TextBlock x:Name="OverviewStatus" Text="Chargement de la vue d'ensemble…" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                </Grid>
            </TabItem>

            <!-- Comptes rendus et PV du projet (Lot 9) : écran Smart Office filtré sur le projet -->
            <TabItem Header="Comptes rendus &amp; PV" x:Name="MeetingsTab">
                <Grid>
                    <wv2:WebView2 x:Name="MeetingsBrowser"/>
                    <TextBlock x:Name="MeetingsStatus" Text="Chargement des comptes rendus…" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                </Grid>
            </TabItem>

            <!-- Import intelligent du dossier du bailleur (Lot 10) : convention, formulaire, budget → fiche, budget, activités… -->
            <TabItem Header="📥 Dossier du bailleur" x:Name="DossierTab">
                <Grid>
                    <wv2:WebView2 x:Name="DossierBrowser"/>
                    <TextBlock x:Name="DossierStatus" Text="Chargement de l'import du dossier…" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                </Grid>
            </TabItem>

            <!-- TAB 7: HISTORIQUE D'AUDIT -->
            <TabItem Header="Historique (Audit)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Piste d'Audit &amp; Historique des Modifications (Audit Trail)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,15"/>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding AuditLogs}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Heure" Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150"/>
                                <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="120"/>
                                <DataGridTextColumn Header="Type Élément" Binding="{Binding EntityType}" Width="110"/>
                                <DataGridTextColumn Header="Champ" Binding="{Binding FieldName}" Width="120"/>
                                <DataGridTextColumn Header="Ancienne Valeur" Binding="{Binding OldValue}" Width="1.5*"/>
                                <DataGridTextColumn Header="Nouvelle Valeur" Binding="{Binding NewValue}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 8: DOCUMENTS FONDATEURS & ANALYSE BAILLEUR -->
            <TabItem Header="📁 Documents &amp; Bailleur" behaviors:FileDrop.Command="{Binding DropDocumentsCommand}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header + Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DOCUMENTS FONDATEURS &amp; SOCLE DE RÉFÉRENCE" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Dossier de projet, conventions bailleurs, mémorandums, budget approuvé, études diagnostiques — référentiel contractuel et base de connaissances" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Document" Command="{Binding OpenUploadDocumentCommand}" Margin="0,0,6,0"/>
                                <Button Content="📦 Import Multiple" Command="{Binding BrowseMultipleDocumentsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="🔍 Analyse Approfondie" Command="{Binding RunDeepAnalysisCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="✍️ تسطير برنامج العمل" Command="{Binding GenerateWorkProgramCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Générer automatiquement le programme de travail, les objectifs et le budget prévisionnel"/>
                                <Button Content="🔄 Synchroniser WBS" Command="{Binding SyncWbsFromBaselineCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="📄 Rapport Conformité PDF" Command="{Binding GeneratePdfDonorComplianceCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>


                        <!-- KPI Bailleur Row -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="15">
                            <StackPanel>
                                <!-- Choix du Bailleur -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                                    <TextBlock Text="Bailleur de Fonds (Charte Graphique, En-tête et Pied de page) :" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <ComboBox ItemsSource="{Binding AvailableFunders}" SelectedValue="{Binding Project.FunderId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="300" VerticalAlignment="Center" Height="28"/>
                                    <Button Content="💾 Enregistrer" Command="{Binding SaveProjectFunderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="15,0,0,0" Height="28" Padding="15,0"/>
                                </StackPanel>
                                <Separator Background="#E2E8F0" Margin="0,0,0,15"/>

                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="TABLEAU DE BORD BAILLEUR — SUIVI DE CONFORMITÉ &amp; CONSOMMATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <UniformGrid Grid.Row="1" Columns="5">
                                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4" Background="#F0F7FF">
                                        <StackPanel>
                                            <TextBlock Text="Total Subvention Contractuelle" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BaselineDiagnostic.TotalGrantCommitted, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4" Background="#FFF7ED">
                                        <StackPanel>
                                            <TextBlock Text="Dépenses Engagées (AC)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BaselineDiagnostic.TotalSpent, StringFormat={}{0:N0} MAD}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4" Background="#F0FDF4">
                                        <StackPanel>
                                            <TextBlock Text="Taux de Consommation" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BaselineDiagnostic.GrantConsumptionRate, StringFormat={}{0:F1}%}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4" Background="#FFF0F0">
                                        <StackPanel>
                                            <TextBlock Text="Prochaine Échéance Rapport" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BaselineDiagnostic.NextReportDueDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="4" Background="#F3E5F5">
                                        <StackPanel>
                                            <TextBlock Text="Score de Conformité" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BaselineDiagnostic.ComplianceScore, StringFormat={}{0:F0}/100}" FontSize="20" FontWeight="Bold" Foreground="#7B1FA2" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Phase Coverage Indicators -->
                                <StackPanel Grid.Row="2" Margin="4,10,4,0">
                                    <TextBlock Text="Couverture Documentaire par Phase du Projet :" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,4" Background="#E0F2FE">
                                            <TextBlock Text="{Binding DiagnosticPhaseDocs, StringFormat={}Diagnostic : {0}}" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                                        </Border>
                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,4" Background="#FEF3C7">
                                            <TextBlock Text="{Binding MontagePhaseDocs, StringFormat={}Montage : {0}}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                        </Border>
                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,4" Background="#ECFDF5">
                                            <TextBlock Text="{Binding RedactionPhaseDocs, StringFormat={}Rédaction : {0}}" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                                        </Border>
                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,4" Background="#F3E8FF">
                                            <TextBlock Text="{Binding ExecutionPhaseDocs, StringFormat={}Exécution : {0}}" FontSize="11" FontWeight="SemiBold" Foreground="#6B21A8"/>
                                        </Border>
                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,4" Background="#FFEDD5">
                                            <TextBlock Text="{Binding EvaluationPhaseDocs, StringFormat={}Évaluation : {0}}" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C"/>
                                        </Border>
                                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,4" Background="#F1F5F9">
                                            <TextBlock Text="{Binding CloturePhaseDocs, StringFormat={}Clôture : {0}}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic Alerts -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,15" Padding="15" Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="DIAGNOSTIC BAILLEUR — SYNTHÈSE ANALYTIQUE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding BaselineDiagnostic.ExecutiveSummary}" TextWrapping="Wrap" FontSize="13" FontStyle="Italic" Margin="0,0,0,12"/>
                                <TextBlock Text="Alertes de conformité :" FontSize="11.5" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,0,6" Visibility="{Binding HasComplianceAlerts, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding BaselineDiagnostic.ComplianceAlerts}" Visibility="{Binding HasComplianceAlerts, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3CD" CornerRadius="4" Padding="10,6" Margin="0,3">
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#856404"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Filter Row -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Filtrer par Catégorie :" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}" VerticalAlignment="Center">
                                <ComboBox.Triggers>
                                    <!-- Simple visual spacing -->
                                </ComboBox.Triggers>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="Phase :" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,8,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding PhaseFilterOptions}" SelectedItem="{Binding SelectedPhaseFilter}" VerticalAlignment="Center"/>

                            <Button Grid.Column="4" Content="Appliquer Filtres" Command="{Binding ApplyDocumentFilterCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="10,4"/>
                        </Grid>

                        <!-- Documents List -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Column Headers -->
                                <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Intitulé du Document / Phase" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,8"/>
                                    <TextBlock Grid.Column="1" Text="Catégorie" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8"/>
                                    <TextBlock Grid.Column="2" Text="Bailleur / Référence" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8"/>
                                    <TextBlock Grid.Column="3" Text="Signature / Échéance" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8"/>
                                    <TextBlock Grid.Column="4" Text="Montant (MAD)" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8"/>
                                    <TextBlock Grid.Column="5" Text="Actions" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8"/>
                                </Grid>
                                <!-- Documents ItemsControl -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                    <ItemsControl ItemsSource="{Binding ProjectDocuments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🔑 " Visibility="{Binding IsKeyReference, Converter={StaticResource BoolToVis}}" ToolTip="Document مرجع أساسي"/>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Border CornerRadius="3" Padding="4,1" Background="#EEF2FF" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding DocumentPhase}" FontSize="9.5" Foreground="#4F46E5" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Padding="8" VerticalAlignment="Center">
                                                            <Border CornerRadius="4" Padding="6,2" Background="#E3F2FD" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#1565C0" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DonorName}" FontSize="11.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DocumentReference}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Margin="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SignatureDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="11.5"/>
                                                            <TextBlock Text="{Binding ContractualEndDate, StringFormat={}Fin: {0:dd/MM/yyyy}}" FontSize="10" Foreground="#D32F2F"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="4" Text="{Binding ApprovedGrantAmount, StringFormat={}{0:N0} MAD}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                                            <Button Content="🔍 Examen" ToolTip="Examiner le texte et les معطيات المستخرجة" Command="{Binding DataContext.PreviewDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="10" Padding="4,2" Height="26" Margin="1" Style="{StaticResource SecondaryButtonStyle}"/>
                                                            <Button Content="Ouvrir" ToolTip="Ouvrir le fichier" Command="{Binding DataContext.OpenDocumentFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="10" Width="36" Height="26" Margin="1" Padding="2"/>
                                                            <Button Content="X" ToolTip="Supprimer" Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="10" Width="24" Height="26" Margin="1" Padding="2" Background="#FFEBEE" Foreground="#D32F2F"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- DOCUMENT PREVIEW MODAL DIALOG OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsDocumentPreviewVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="700" Height="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding PreviewDocumentTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                    <TabControl Grid.Row="1" Margin="0,5,0,10">
                        <TabItem Header="النص المستخرج الكامل">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding PreviewDocumentContent}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Padding="10" Background="#F8FAFC" BorderThickness="0"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="المعطيات والمعلومات المستخرجة">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding PreviewDocumentInsights}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12.5" Padding="12" Background="#F0FDF4" Foreground="#166534" BorderThickness="0"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="إغلاق المعاينة" Click="OnCancelDocumentPreviewClick" Padding="15,6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- AUTOMATIC WORK PROGRAM MODAL DIALOG OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsWorkProgramModalVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="860" Height="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="✍️ برنامج العمل والأهداف والتكاليف المُسطّرة تلقائياً" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding GeneratedProgram.ProjectName, StringFormat={}Projet : {0} — Synthèse basée sur la base de connaissances documentaire}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{Binding GeneratedProgram.TotalBudget, StringFormat={}Budget Total : {0:N0} MAD}" FontSize="13" FontWeight="Bold" Foreground="#4F46E5"/>
                        </Border>
                    </Grid>

                    <TabControl Grid.Row="1" Margin="0,5,0,10">
                        <!-- Tab 1: Objectives & Results -->
                        <TabItem Header="🎯 الأهداف والنتائج المنتظرة">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">

                                    <TextBlock Text="الأهداف العامة للمشروع (General Objectives)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding GeneratedProgram.GeneralObjectives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="📌 " FontSize="12"/>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="الأهداف الخاصة والتنفيذية (Specific Objectives)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,15,0,8"/>
                                    <ItemsControl ItemsSource="{Binding GeneratedProgram.SpecificObjectives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="🔹 " FontSize="12"/>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="مؤشرات الإنجاز والنتائج المتوقعة (Key Indicators &amp; Deliverables)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,15,0,8"/>
                                    <ItemsControl ItemsSource="{Binding GeneratedProgram.KeyIndicators}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0FDF4" CornerRadius="4" Padding="10,6" Margin="0,3">
                                                    <TextBlock Text="{Binding StringFormat='✓ {0}'}" FontSize="11.5" Foreground="#166534" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Activities Breakdown -->
                        <TabItem Header="📅 برنامج الأنشطة وخطة العمل">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="الأنشطة التنفيذية المُسطّرة بحسب مراحل المشروع :" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GeneratedProgram.Activities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8" Background="#FAFAFA">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Border Background="#1E3A8A" CornerRadius="12" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Index, StringFormat='A{0}'}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A" Margin="0,0,10,0"/>
                                                                <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Phase}" FontSize="10" Foreground="#1E40AF" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ExpectedDeliverable, StringFormat='Livrable attendu : {0}'}" FontSize="10.5" FontStyle="Italic" Foreground="#047857" Margin="0,4,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EstimatedBudget, StringFormat={}{0:N0} MAD}" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding DurationWeeks, StringFormat='Durée : {0} sem.'}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: Expected Budget Ledger -->
                        <TabItem Header="💰 المصاريف والميزانية المتوقعة">
                            <Grid Margin="10">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="تقدير التكاليف والمصاريف المتوقعة حسب فئات الإنفاق :" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GeneratedProgram.BudgetLedger}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8" Background="#FFFBF0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="12.5" Foreground="#92400E"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#78350F" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FundingSource, StringFormat='Source : {0}'}" FontSize="10" Foreground="#B45309" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding EstimatedCost, StringFormat={}{0:N0} MAD}" FontSize="14" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>


                        <!-- Tab 4: Proposal Full Markdown Text -->
                        <TabItem Header="📝 الصياغة الكاملة للمقترح (Proposal Text)">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding GeneratedProgram.FullProposalMarkdown}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Padding="15" Background="#F8FAFC" BorderThickness="0"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Dialog Footer Action Buttons -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="📄 تصدير إلى Word (.docx)" Command="{Binding ExportWorkProgramToWordCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button Content="⚡ اعتماد وتطبيق في WBS والميزانية" Command="{Binding ApplyWorkProgramToWbsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="إغلاق" Click="OnCancelWorkProgramClick" HorizontalAlignment="Right" Padding="15,6"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <!-- DOCUMENT UPLOAD DIALOG OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsDocumentUploadVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="580" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ajouter un Document Fondateur" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" MaxHeight="480">
                        <StackPanel>
                            <!-- Title -->
                            <TextBlock Text="Intitulé du document *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingDocument.Title}" Margin="0,5,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Category -->
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Catégorie" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox SelectedItem="{Binding EditingDocument.Category}" Margin="0,5,0,0">
                                        <ComboBoxItem Content="Convention / Accord de Financement Bailleur"/>
                                        <ComboBoxItem Content="Dossier de Montage &amp; Fiche Projet Initiale"/>
                                        <ComboBoxItem Content="Budget Initial Approuvé"/>
                                        <ComboBoxItem Content="Étude de Faisabilité &amp; Diagnostic"/>
                                        <ComboBoxItem Content="Cadre Logique &amp; Matrice d'Indicateurs"/>
                                        <ComboBoxItem Content="Correspondance &amp; Avenant Contractuel"/>
                                        <ComboBoxItem Content="Autre Document Fondateur"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Phase -->
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Phase du Projet" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox SelectedItem="{Binding EditingDocument.DocumentPhase}" Margin="0,5,0,0">
                                        <ComboBoxItem Content="Diagnostic"/>
                                        <ComboBoxItem Content="Montage"/>
                                        <ComboBoxItem Content="Rédaction"/>
                                        <ComboBoxItem Content="Exécution"/>
                                        <ComboBoxItem Content="Évaluation"/>
                                        <ComboBoxItem Content="Clôture"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Key Reference & Version -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="🔑 Document Méréférentiel Clé" IsChecked="{Binding EditingDocument.IsKeyReference}" VerticalAlignment="Center" ToolTip="Ce document sera utilisé comme référence prioritaire dans la rédaction des rapports"/>

                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Version (ex: v1.0, Avenant 2)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding EditingDocument.DocumentVersion}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Donor Name -->
                            <TextBlock Text="Nom du Bailleur / Partie signataire" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingDocument.DonorName}" Margin="0,5,0,10"/>

                            <!-- Reference -->
                            <TextBlock Text="Code / Référence du document" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingDocument.DocumentReference}" Margin="0,5,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Signature Date -->
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Date de Signature" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditingDocument.SignatureDate}" Height="34" Margin="0,5,0,0"/>
                                </StackPanel>
                                <!-- Contractual End Date -->
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Date Fin Contractuelle" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditingDocument.ContractualEndDate}" Height="34" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Approved Grant Amount -->
                            <TextBlock Text="Montant Subvention Approuvé (MAD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingDocument.ApprovedGrantAmount}" Margin="0,5,0,10"/>

                            <!-- Description -->
                            <TextBlock Text="Description / Notes" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingDocument.Description}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,10"/>

                            <!-- File Path Picker -->
                            <TextBlock Text="Fichier Source (PDF, Word, Excel...)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditingDocument.OriginalFilePath}" IsReadOnly="True" Background="#F9FAFB"/>
                                <Button Grid.Column="1" Content="Parcourir..." Command="{Binding BrowseDocumentFileCommand}" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Click="OnCancelDocumentUploadClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Enregistrer Document" Command="{Binding SaveDocumentCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <!-- ADD/EDIT TASK DIALOG OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsTaskEditVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="450" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Fiche de la Tâche" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <StackPanel>
                            <!-- Task Name -->
                            <TextBlock Text="Nom de la Tâche *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingTask.Name}" Margin="0,5,0,10"/>

                            <!-- Description -->
                            <TextBlock Text="Description" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingTask.Description}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,10"/>

                            <!-- Assignee -->
                            <TextBlock Text="Responsable (Assigné)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingTask.Assignee}" Margin="0,5,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Start Date -->
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Date Début Prévue" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditingTask.TargetStartDate}" Height="34" Margin="0,5,0,10"/>
                                </StackPanel>

                                <!-- End Date -->
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Date Fin Prévue" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <DatePicker SelectedDate="{Binding EditingTask.TargetEndDate}" Height="34" Margin="0,5,0,10"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Budget -->
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Budget Alloué (MAD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding EditingTask.Budget}" Margin="0,5,0,10"/>
                                </StackPanel>

                                <!-- Cost -->
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Coût Réel Engagé (MAD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding EditingTask.Cost}" Margin="0,5,0,10"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Progress -->
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Avancement (%)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding EditingTask.ProgressPercentage}" Margin="0,5,0,10"/>
                                </StackPanel>

                                <!-- Status -->
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Statut" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox SelectedItem="{Binding EditingTask.Status}" Margin="0,5,0,10">
                                        <ComboBoxItem Content="À faire"/>
                                        <ComboBoxItem Content="En cours"/>
                                        <ComboBoxItem Content="Terminé"/>
                                        <ComboBoxItem Content="Bloqué"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Predecessors -->
                            <TextBlock Text="Prédécesseurs (IDs de tâches séparés par virgules, ex: 12)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding EditingTask.Predecessors}" Margin="0,5,0,10"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Click="OnCancelTaskClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveTaskCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ADD COST DIALOG OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsCostEditVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="400" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Enregistrer une Dépense" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <!-- Category -->
                        <TextBlock Text="Catégorie *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox SelectedItem="{Binding EditingCost.Category}" Margin="0,5,0,10">
                            <ComboBoxItem Content="Ressources"/>
                            <ComboBoxItem Content="Matériel"/>
                            <ComboBoxItem Content="Prestataires"/>
                            <ComboBoxItem Content="Divers"/>
                        </ComboBox>

                        <!-- Description -->
                        <TextBlock Text="Description / Intitulé *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding EditingCost.Description}" Margin="0,5,0,10"/>

                        <!-- ResourceName / Supplier -->
                        <TextBlock Text="Bénéficiaire / Fournisseur" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding EditingCost.ResourceName}" Margin="0,5,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Estimated Cost -->
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="Budget Prévu (MAD)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditingCost.EstimatedCost}" Margin="0,5,0,10"/>
                            </StackPanel>

                            <!-- Actual Cost -->
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Montant Réel (MAD) *" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding EditingCost.ActualCost}" Margin="0,5,0,10"/>
                            </StackPanel>
                        </Grid>

                        <!-- Date -->
                        <TextBlock Text="Date" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <DatePicker SelectedDate="{Binding EditingCost.Date}" Height="34" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Click="OnCancelCostClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Enregistrer Dépense" Command="{Binding SaveCostCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ADD WORKFLOW STEP DIALOG OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsStepEditVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Width="400" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ajouter une Étape de Workflow" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <!-- Step Name -->
                        <TextBlock Text="Nom de la phase / Jalon *" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding EditingStep.StepName}" Margin="0,5,0,10"/>

                        <!-- Order -->
                        <TextBlock Text="Ordre de passage" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding EditingStep.Order}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Click="OnCancelStepClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Ajouter Étape" Command="{Binding SaveStepCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ONG: ACTIVITY REPORT WIZARD OVERLAY -->
        <Grid Grid.RowSpan="2" Background="#7F000000" Visibility="{Binding IsActivityReportWizardVisible, Converter={StaticResource BoolToVis}}">
            <views:ActivityReportWizardView DataContext="{Binding ActivityReportWizard}" />
        </Grid>
    </Grid>
</UserControl>
