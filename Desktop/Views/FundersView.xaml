<UserControl x:Class="AFMI_Gestion_projet.Views.FundersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AFMI_Gestion_projet.Views"
             xmlns:viewmodels="clr-namespace:AFMI_Gestion_projet.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:FundersViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!-- Liste des Bailleurs -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#20000000" BlurRadius="10" ShadowDepth="2" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bailleurs de Fonds" FontSize="20" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="+ Nouveau Bailleur" Command="{Binding AddFunderCommand}" 
                            Padding="15,8" Background="#0066CC" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Funders}" SelectedItem="{Binding SelectedFunder}" 
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          Background="Transparent" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                        <DataGridTemplateColumn Header="Couleur" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="20" Height="20" Background="{Binding PrimaryColor}" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Command="{Binding DataContext.DeleteFunderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red" Cursor="Hand" ToolTip="Supprimer" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Formulaire d'édition -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect Color="#20000000" BlurRadius="10" ShadowDepth="2" Direction="270" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Détails du Bailleur" FontSize="18" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,20" />

                <TextBlock Text="Nom du Bailleur" Foreground="#666666" Margin="0,0,0,5" />
                <TextBox Text="{Binding SelectedFunder.Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" />

                <TextBlock Text="Couleur Primaire (HEX)" Foreground="#666666" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedFunder.PrimaryColor, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                    <Border Grid.Column="1" Width="30" Height="30" Margin="10,0,0,0" Background="{Binding SelectedFunder.PrimaryColor, FallbackValue=#DDDDDD}" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1" />
                </Grid>

                <TextBlock Text="Logo" Foreground="#666666" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedFunder.LogoPath}" IsReadOnly="True" Padding="8" Foreground="#888888" />
                    <Button Grid.Column="1" Content="Parcourir" Command="{Binding BrowseLogoCommand}" Margin="10,0,0,0" Padding="15,5" Background="#EEEEEE" BorderThickness="0" Cursor="Hand" />
                </Grid>

                <TextBlock Text="Mentions Légales" Foreground="#666666" Margin="0,0,0,5" />
                <TextBox Text="{Binding SelectedFunder.LegalMentions, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="8" Margin="0,0,0,15" />

                <TextBlock Text="Entête personnalisé (Header)" Foreground="#666666" Margin="0,0,0,5" />
                <TextBox Text="{Binding SelectedFunder.HeaderText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Padding="8" Margin="0,0,0,15" />

                <TextBlock Text="Pied de page personnalisé (Footer)" Foreground="#666666" Margin="0,0,0,5" />
                <TextBox Text="{Binding SelectedFunder.FooterText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Padding="8" Margin="0,0,0,15" />

                <!-- Lot 10 : traitement des contributions en nature, choisi pour chaque bailleur -->
                <TextBlock Text="Contributions en nature (cofinancement)" Foreground="#666666" Margin="0,0,0,5" />
                <ComboBox SelectedValue="{Binding SelectedFunder.InKindTreatment, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,4">
                    <ComboBoxItem Tag="Suivi" Content="Suivi seulement (tableau de cofinancement)"/>
                    <ComboBoxItem Tag="Comptabilité" Content="Suivi + écriture comptable de valorisation"/>
                </ComboBox>
                <TextBlock Text="« Comptabilité » : chaque réalisation exige un justificatif et produit une écriture équilibrée (emploi = ressource), sans effet sur le résultat ni sur la trésorerie."
                           Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,25" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Annuler" Command="{Binding CancelEditCommand}" Padding="10,10" Background="#EEEEEE" Foreground="#333333" BorderThickness="0" Cursor="Hand" />
                    <Button Grid.Column="2" Content="Enregistrer" Command="{Binding SaveFunderCommand}" Padding="10,10" Background="#28A745" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
