<UserControl behaviors:FileDrop.Command="{Binding DropPhotosCommand}" x:Class="AFMI_Gestion_projet.Views.ActivityReportWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:behaviors="clr-namespace:AFMI_Gestion_projet.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:AFMI_Gestion_projet.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="700"
             Background="#99000000"
             d:DataContext="{d:DesignInstance Type=viewmodels:ActivityReportWizardViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Border Background="White" CornerRadius="10" Width="650" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <TextBlock Grid.Row="0" Text="Nouveau Compte Rendu d'Activité" FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,20"/>

                <!-- ÉTAPE 1: Généralités -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Étape 1/3 : Informations Générales" FontSize="16" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Titre du compte rendu *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Report.Title, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date de l'activité *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Report.ActivityDate}" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lieu *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Report.Location}" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Nombre de participants" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Report.ParticipantsCount}" Padding="8" Width="150" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- ÉTAPE 2: Narratif & Indicateurs -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Étape 2/3 : Narratif et Indicateurs" FontSize="16" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,15"/>

                    <TextBlock Text="Indicateur lié au projet" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableIndicators}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Report.IndicatorId}" Padding="6" Margin="0,0,0,15"/>

                    <TextBlock Text="Narratif de réalisation" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Report.Narrative}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Difficultés rencontrées" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Report.Difficulties}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8" Margin="0,0,0,10"/>

                    <TextBlock Text="Recommandations" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Report.Recommendations}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8"/>
                </StackPanel>

                <!-- ÉTAPE 3: Photos -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Étape 3/3 : Photos et Médias" FontSize="16" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,15"/>
                    
                    <Button Content="+ Ajouter des photos" Command="{Binding AddPhotoCommand}" Background="#EEEEEE" Padding="10" BorderThickness="0" Margin="0,0,0,15"/>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="280">
                        <ItemsControl ItemsSource="{Binding Photos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Background="#F9F9F9" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Image preview (simplified string path for now, requires converter for actual image) -->
                                            <TextBlock Grid.Column="0" Text="{Binding LocalFilePath}" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="Légende de la photo :" FontSize="11" Foreground="#666666"/>
                                                <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="X" Foreground="Red" Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Boutons de navigation (Footer) -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Annuler" Command="{Binding CancelCommand}" Padding="15,8" Background="Transparent" Foreground="#666666" BorderThickness="0" Cursor="Hand"/>
                    
                    <Button Grid.Column="2" Content="Précédent" Command="{Binding PreviousStepCommand}" Padding="15,8" Background="#EEEEEE" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Grid.Column="4" Content="Suivant" Command="{Binding NextStepCommand}" Padding="15,8" Background="#0066CC" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="4" Content="Soumettre" Command="{Binding SubmitCommand}" Padding="15,8" Background="#28A745" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
